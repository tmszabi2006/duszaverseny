# MineScript szerver – környezeti változók
# Másold le .env néven, és töltsd ki az értékeket!

NODE_ENV=production
PORT=3000

# MySQL 8 kapcsolat
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=minescript
DB_PASSWORD=valtoztasd-meg
DB_NAME=minescript

# Csak a db:init futtatásához, ha az alkalmazás felhasználója nem hozhat létre
# adatbázist. Hagyd üresen, ha a DB_USER jogosult a CREATE DATABASE műveletre.
# DB_ADMIN_USER=root
# DB_ADMIN_PASSWORD=root-jelszo

# Legalább 32 karakteres, véletlen titok. Például:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=valtoztasd-meg-legalabb-32-karakteres-veletlen-titok

# Munkamenet hossza napokban
SESSION_DAYS=7

# HTTPS mögött állva igaz; helyi HTTP fejlesztésnél hamis/hagyd üresen.
COOKIE_SECURE=true

# Apache reverse proxy mögött 1, közvetlen Node kiszolgálásnál 0.
TRUST_PROXY=1
